<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Space Engineers 2 plugin entry point: Tether.dll, a deliberately tiny loader shim. It depends only on
    the base library and the game's IPlugin/PluginHost, then hands over to Tether.Runtime (src/Tether.Runtime).

    Output: Tether.dll plus Tether.Runtime.dll, Tether.Core.dll and LiteNetLib.dll. Load it with the game's
    launch option -plugins:"<install folder>\Tether.dll".

    Game references come from one of two places:
      * TetherUseGameReferences=true: your local game install (see build/Game2.props). The default when the
        game is found; this gives the strongest compile-time checks.
      * TetherUseGameReferences=false: Tether's hand-written interop declarations (ref/VRage.Core.Interop).
        The default when no game is found. Release builds always use this, so anyone can rebuild a release
        byte-for-byte from this repository alone.
    Either way, game assemblies are referenced in place and never copied or shipped.
  -->
  <Import Project="..\..\build\Game2.props" />

  <PropertyGroup>
    <TargetFramework>$(TetherTargetFramework)</TargetFramework>
    <AssemblyName>Tether</AssemblyName>
    <RootNamespace>Tether.Plugin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Plugin-style output: copies NuGet dependencies next to the DLL, excludes the shared framework. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TetherUseGameReferences)' == ''">
    <TetherUseGameReferences Condition="'$(Game2Dir)' != '' and Exists('$(Game2Dir)/VRage.Core.dll')">true</TetherUseGameReferences>
    <TetherUseGameReferences Condition="'$(TetherUseGameReferences)' == ''">false</TetherUseGameReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tether.Runtime\Tether.Runtime.csproj" />
  </ItemGroup>

  <!-- At compile time Tether needs only IPlugin and PluginHost (Keen.VRage.Core.Plugins). Everything else
       is reached through reflection until Phase 0 confirms the API. -->
  <ItemGroup Condition="'$(TetherUseGameReferences)' == 'true'">
    <Reference Include="VRage.Core">
      <HintPath>$(Game2Dir)/VRage.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TetherUseGameReferences)' != 'true'">
    <ProjectReference Include="..\..\ref\VRage.Core.Interop\VRage.Core.Interop.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="TetherReportReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(TetherUseGameReferences)' == 'true' and !Exists('$(Game2Dir)/VRage.Core.dll')"
           Text="TetherUseGameReferences=true but VRage.Core.dll was not found in Game2Dir '$(Game2Dir)'." />
    <Message Importance="high" Condition="'$(TetherUseGameReferences)' == 'true'" Text="Tether: compiling against the game assemblies in $(Game2Dir)" />
    <Message Importance="high" Condition="'$(TetherUseGameReferences)' != 'true'" Text="Tether: compiling against Tether's interop declarations (no game install needed)" />
  </Target>

  <!-- Belt and braces: a game assembly (real or our declaration) must never end up next to Tether.dll. -->
  <Target Name="TetherNoGameAssembliesInOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <_TetherForbidden Include="$(OutDir)VRage.*.dll;$(OutDir)Game2.*.dll;$(OutDir)SpaceEngineers2*.dll;$(PublishDir)VRage.*.dll;$(PublishDir)Game2.*.dll;$(PublishDir)SpaceEngineers2*.dll" />
    </ItemGroup>
    <Error Condition="'@(_TetherForbidden)' != ''" Text="Game assemblies must never be shipped with Tether: @(_TetherForbidden)" />
  </Target>
</Project>
