<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Game-independent core: protocol, transports, sessions.
    Must never reference Space Engineers 2 assemblies, so it builds and tests anywhere (CI on Linux and Windows).
  -->
  <PropertyGroup>
    <TargetFramework>$(TetherTargetFramework)</TargetFramework>
    <RootNamespace>Tether</RootNamespace>
    <AssemblyName>Tether.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tether.Core.Tests" />
  </ItemGroup>
</Project>
